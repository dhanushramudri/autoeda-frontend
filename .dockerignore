# Secrets — never bake these into the image. Runtime config comes from
# `docker run --env-file` / compose `env_file`, not from anything copied
# in at build time.
.env
.env.local
.env.*.local
.env.production
.env.development

.git
.gitignore

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output — regenerated by `npm run build` inside the image
.next/
out/

.vscode/
.idea/
*.swp
*.swo
*~

README.md
.DS_Store
Thumbs.db
*.tmp
tmp/
temp/
coverage/
.turbo
.vercel
